{
  "name": "@qorvex/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "build": "nest build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/flows.test.cjs test/dashboard-snapshot.test.cjs test/auth-cache.test.cjs test/production-board.test.cjs",
    "test:demo": "pnpm build && dotenv -e ../../.env -- node test/demo-integration.cjs",
    "test:stock": "pnpm build && dotenv -e ../../.env -- node test/store-stock-integration.cjs",
    "test:http": "pnpm build && dotenv -e ../../.env -- node test/http-smoke.cjs",
    "test:dashboard-performance": "pnpm build && dotenv -e ../../.env -- node test/dashboard-performance.cjs",
    "test:module-performance": "pnpm build && dotenv -e ../../.env -- node test/module-performance.cjs",
    "test:channel-orders": "node test/channel-orders-integration.cjs",
    "test:hotel": "node ../../packages/database/node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.json --test src/modules/hotel/hotel-availability.spec.ts",
    "test:web-catalog": "node ../../packages/database/node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.json --test src/modules/web-catalog/web-catalog.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.3",
    "@qorvex/database": "workspace:*",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "read-excel-file": "^9.2.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.20.0",
    "rxjs": "^7.8.2",
    "web-push": "3.6.7"
  },
  "dependenciesMeta": {
    "@qorvex/database": {
      "injected": true
    }
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.3",
    "@types/web-push": "3.6.4",
    "dotenv-cli": "^8.0.0",
    "typescript": "^5.8.3"
  }
}
