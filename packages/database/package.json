{
  "name": "@qorvex/database",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "generate": "dotenv -e ../../.env -- prisma generate --schema prisma/schema.prisma",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev --schema prisma/schema.prisma",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy --schema prisma/schema.prisma",
    "cleanup:rivnu": "dotenv -e ../../.env -- tsx prisma/cleanup-rivnu-for-launch.ts",
    "cleanup:rivnu:operational": "dotenv -e ../../.env -- tsx prisma/cleanup-rivnu-operational-data.ts",
    "import:allpa-products": "dotenv -e ../../.env -- tsx prisma/import-allpa-products.ts",
    "ensure:allpa-warehouse-keeper": "dotenv -e ../../.env -- tsx prisma/ensure-allpa-warehouse-keeper.ts",
    "update:allpa-team": "dotenv -e ../../.env -- tsx prisma/update-allpa-team.ts",
    "enable:allpa-admin-pos": "dotenv -e ../../.env -- tsx prisma/enable-allpa-admin-pos.ts",
    "repair:warehouse-stock": "dotenv -e ../../.env -- tsx prisma/repair-warehouse-stock-rows.ts",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "seed:demo": "dotenv -e ../../.env -- tsx prisma/seed-hotel-demo.ts",
    "dgii:import": "dotenv -e ../../.env -- tsx prisma/import-dgii-registry.ts",
    "hotel:replace-inventory": "dotenv -e ../../.env -- tsx prisma/replace-hotel-inventory.ts",
    "verify:demo": "dotenv -e ../../.env -- tsx prisma/verify-hotel-demo.ts",
    "studio": "dotenv -e ../../.env -- prisma studio --schema prisma/schema.prisma",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "ensure:demo-3d-product": "dotenv -e ../../.env -- tsx prisma/ensure-demo-3d-product.ts",
    "import:web-catalog": "tsx src/web-catalog-import/cli.ts",
    "import:web-catalog:remote": "dotenv -e ../../.env -- tsx src/web-catalog-import/remote-cli.ts",
    "test:web-catalog": "tsx --test src/web-catalog-import/importer.test.ts",
    "test:web-catalog:integration": "tsx --test src/web-catalog-import/integration.test.ts",
    "test:security-hardening": "node security/supabase-hardening/test-local.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
