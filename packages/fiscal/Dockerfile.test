# Build a disposable offline validator/test runner; never use a production container.
FROM node:22-bookworm-slim
RUN apt-get update \
    && apt-get install --no-install-recommends --yes libxml2-utils \
    && rm -rf /var/lib/apt/lists/*
USER node
WORKDIR /workspace/packages/fiscal
ENTRYPOINT ["node", "--experimental-strip-types", "--test"]
CMD ["test/core.test.ts", "test/schema.test.ts", "test/mapper.test.ts", "test/erp-sales-adapter.test.ts", "test/http-service.test.ts"]
