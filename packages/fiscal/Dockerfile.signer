FROM node:22-bookworm-slim AS dependencies
RUN corepack enable && corepack prepare pnpm@10.12.4 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/fiscal/package.json ./packages/fiscal/package.json
RUN pnpm install --filter @corestack/fiscal --frozen-lockfile --ignore-scripts

FROM dependencies AS production-dependencies
RUN pnpm --filter @corestack/fiscal --prod deploy /runtime

FROM node:22-bookworm-slim AS runtime
RUN apt-get update && apt-get install --no-install-recommends --yes libxml2-utils xmlsec1 openssl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app/fiscal
COPY --from=production-dependencies --chown=10001:4101 /runtime/node_modules ./node_modules
COPY --chown=10001:4101 packages/fiscal/package.json ./
COPY --chown=10001:4101 packages/fiscal/src ./src
COPY --chown=10001:4101 packages/fiscal/schemas ./schemas
USER 10001:4101
HEALTHCHECK --interval=15s --timeout=3s --start-period=30s --retries=3 \
  CMD node -e "const fs=require('node:fs');const h=JSON.parse(fs.readFileSync('/tmp/fiscal-signer-health.json','utf8'));if(Date.now()-h.checkedAt>60000)process.exit(1)"
CMD ["node", "--experimental-strip-types", "src/signer-main.ts"]
