FROM node:22-bookworm-slim
RUN apt-get update && apt-get install --no-install-recommends --yes \
    ca-certificates libxml2-utils xmlsec1 openssl qrencode util-linux \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app/fiscal
COPY --chown=10004:4101 packages/fiscal/package.json ./
COPY --chown=10004:4101 packages/fiscal/src ./src
COPY --chown=10004:4101 packages/fiscal/schemas ./schemas
USER 10004:4101
EXPOSE 8445
# OS lock is released by the kernel on crash. No stale lock-directory bypass.
CMD ["flock", "-n", "/evidence/.runner.lock", "node", "--experimental-strip-types", "src/certification-runner-main.ts"]
