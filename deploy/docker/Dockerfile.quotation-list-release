FROM corestack/rivnu-api:cashier-print-discard-20261112 AS api

USER root
COPY --chown=node:node apps/api/src/modules/orders/orders.controller.ts /app/apps/api/src/modules/orders/orders.controller.ts
COPY --chown=node:node apps/api/src/modules/orders/orders.service.ts /app/apps/api/src/modules/orders/orders.service.ts
USER node
WORKDIR /app
RUN cd apps/api && ./node_modules/.bin/tsc --noEmit && ./node_modules/.bin/nest build
EXPOSE 4000
CMD ["node", "apps/api/dist/main.js"]

FROM corestack/rivnu-web:e31-identity-20261112 AS web

ENV NEXT_PUBLIC_API_URL=https://rivnu-api.corestack-systems.com
ENV NEXT_PUBLIC_APP_URL=https://rivnu.corestack-systems.com
USER root
COPY --chown=node:node apps/web/lib/api.ts /app/apps/web/lib/api.ts
COPY --chown=node:node apps/web/components/operations/quotations-view.tsx /app/apps/web/components/operations/quotations-view.tsx
USER node
WORKDIR /app
RUN cd apps/web && ./node_modules/.bin/tsc --noEmit && ./node_modules/.bin/next build && ./node_modules/.bin/tsc --noEmit
EXPOSE 3000
CMD ["./apps/web/node_modules/.bin/next", "start", "apps/web", "--port", "3000", "--hostname", "0.0.0.0"]
