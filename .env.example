# Local Docker PostgreSQL defaults. Replace when targeting Supabase.
DATABASE_URL="postgresql://corestack:corestack@localhost:5432/corestack?schema=public"
DIRECT_URL="postgresql://corestack:corestack@localhost:5432/corestack?schema=public"

# Supabase PostgreSQL placeholders for temporary managed DB usage.
# Encode special characters in the password, for example @ becomes %40.
# DATABASE_URL="postgresql://postgres.ofiajrknxhtquctgrysr:YOUR_URL_ENCODED_PASSWORD@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL="postgresql://postgres.ofiajrknxhtquctgrysr:YOUR_URL_ENCODED_PASSWORD@aws-1-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require"

# Local Docker compose values.
POSTGRES_USER="corestack"
POSTGRES_PASSWORD="corestack"
POSTGRES_DB="corestack"

# Backend auth. Never use Supabase JWT secret here. Production requires a unique
# value of at least 32 characters and refuses placeholders.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-corestack-secret"
JWT_EXPIRES_IN="8h"

# API / CORS.
API_PORT=4000
CORS_ORIGIN="http://localhost:3000,https://YOUR_FRONTEND_VERCEL_URL"
TRUST_PROXY=1
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
API_JSON_BODY_LIMIT="1mb"
API_FORM_BODY_LIMIT="1mb"

# Internal-only access control. Empty means no application-level IP restriction.
# Enforce the same policy at Vercel Firewall/Zero Trust in production.
# Use office/VPN static IPs or CIDR ranges, for example: "203.0.113.10,198.51.100.0/24"
INTERNAL_ALLOWED_IPS=""

# Frontend.
NEXT_PUBLIC_API_URL="/api"
API_INTERNAL_URL="http://localhost:4000"
# Optional base URL used when generating a QR to capture OCR from a phone.
# Leave empty in Vercel: the current HTTPS origin is detected automatically.
# For local mobile testing use a public HTTPS tunnel or preview URL, never an IP over HTTP.
NEXT_PUBLIC_APP_URL=""

# Short-lived phone OCR handoff. These are backend-only rate-limit settings.
MOBILE_OCR_PUBLIC_RATE_LIMIT_WINDOW_MS=600000
MOBILE_OCR_PUBLIC_RATE_LIMIT_MAX=30

# Backend-only Supabase values. Never expose these with NEXT_PUBLIC_.
SUPABASE_URL="https://ofiajrknxhtquctgrysr.supabase.co"
# Prefer SUPABASE_SERVICE_ROLE_KEY for Storage uploads. SUPABASE_SECRET_KEY is also supported.
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_SECRET_KEY="replace-with-secret-key"
SUPABASE_JWKS_URL="https://ofiajrknxhtquctgrysr.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_PRODUCT_IMAGE_BUCKET="product-images"
# Local uploads for the demo; use supabase only after Storage is configured.
PRODUCT_IMAGE_STORAGE="local"

# Shopify (backend only). CoreStack is the source of truth for catalog and stock.
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_ADMIN_ACCESS_TOKEN="replace-with-shopify-admin-token"
SHOPIFY_CLIENT_SECRET="replace-with-shopify-client-secret"
SHOPIFY_API_VERSION="2026-10"
SHOPIFY_TENANT_SLUG="hotel-ancla"
SHOPIFY_LOCATION_ID="gid://shopify/Location/replace-me"
SHOPIFY_DEFAULT_PROMISE_DAYS=3

# Transactional email: intentionally disabled for the demo.
ENABLE_EMAIL_DELIVERY=false
# Transactional email (order ready notices and e-CF copies).
RESEND_API_KEY="replace-with-resend-api-key"
RESEND_FROM="Hotel Ancla <notificaciones@your-verified-domain.com>"
RESEND_ECF_TEMPLATE_ID="replace-with-resend-template-id"

# Idempotent initial bootstrap. Keep real passwords only in the ignored .env.
SEED_HOTEL_ADMIN_EMAIL="admin@hotelancla.local"
SEED_HOTEL_ADMIN_PASSWORD="replace-with-a-strong-hotel-password"
SEED_HOTEL_DEMO_PASSWORD="replace-with-a-shared-demo-password"
SEED_CORESTACK_ADMIN_EMAIL="soporte@corestack-systems.com"
SEED_CORESTACK_ADMIN_PASSWORD="replace-with-a-different-strong-password"

# Canal servidor a servidor (/channel/*) usado por el sitio web de reservas (apps/website).
# El API y el sitio comparten estos valores; el secreto NUNCA va en variables NEXT_PUBLIC_.
# Genera el secreto con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CHANNEL_API_KEY_ID="hotel-website"
CHANNEL_API_SECRET="replace-with-a-random-secret-of-at-least-32-chars"
CHANNEL_TENANT_SLUG="hotel-ancla"
# Impuesto aplicado a reservas web (0 a 0.5). El total con impuesto es lo que queda en la reserva del ERP.
HOTEL_WEB_TAX_RATE=0.18
# Sitio web: URL base del API del ERP (sin barra final). Si falta, usa API_INTERNAL_URL.
ERP_API_URL="http://localhost:4000"

# Notificaciones push del ERP (avisos de nuevas solicitudes de reserva al celular del administrador).
# Genera las claves una sola vez: cd apps/api && node -e "console.log(require('web-push').generateVAPIDKeys())"
# Si cambian, cada dispositivo debe volver a activar los avisos.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="https://hotel-ancla-website.vercel.app"
